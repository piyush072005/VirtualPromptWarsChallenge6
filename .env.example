# Optional server-side GenAI configuration (never exposed to browser)
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash

# Alternative OpenAI-compatible endpoint
# OPENAI_API_KEY=your_openai_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Server binding
PORT=3001
HOST=127.0.0.1
# Set to true to use regional winter smog presets offline without Open-Meteo lookups
DISABLE_LIVE_AIR_FETCH=false
